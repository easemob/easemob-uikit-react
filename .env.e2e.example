# Copy to .env.e2e.local in the repository root and fill in your credentials.
# Existing shell environment variables take precedence over this file.
EASEMOB_APPKEY=

# Account A (caller). Set either TOKEN or PASSWORD for each account.
EASEMOB_USERID=
EASEMOB_TOKEN=
EASEMOB_PASSWORD=

# Account B (callee)
EASEMOB_SECOND_USERID=
EASEMOB_SECOND_TOKEN=
EASEMOB_SECOND_PASSWORD=

# Account C (conference / additional invite)
EASEMOB_THIRD_USERID=
EASEMOB_THIRD_TOKEN=
EASEMOB_THIRD_PASSWORD=

# Account D (non-participant / four-person conference)
EASEMOB_FOURTH_USERID=
EASEMOB_FOURTH_TOKEN=
EASEMOB_FOURTH_PASSWORD=

# Optional: reuse a running demo instead of starting a test server.
# E2E_BASE_URL=http://127.0.0.1:5174

# Optional: demo proxy targets (defaults shown).
# EASEMOB_DEMO_REST_PROXY_TARGET=http://127.0.0.1:8082
# EASEMOB_DEMO_MSYNC_PROXY_TARGET=ws://127.0.0.1:4717
# EASEMOB_DEMO_FUSION_PROXY_TARGET=ws://127.0.0.1:8081

# Optional: connect directly to custom IM services.
# EASEMOB_E2E_SERVICE_MODE=custom
# EASEMOB_REST_URL=http://127.0.0.1:8082
# EASEMOB_WS_URL=ws://127.0.0.1:4717

# Optional: override RTC project for CallKit tests (must allow token-free calls).
# Leave unset to get RTC App ID and Token through the IM SDK.
# EASEMOB_RTC_APP_ID=

# Optional: speech recognition environment (defaults shown).
# CALLKIT_ASR_PYTHON=.local/callkit/venv/bin/python
# CALLKIT_ASR_MODEL=base
# HF_HOME=.local/callkit/hf
